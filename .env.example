# SQLite veritabanı dosyası
SQLITE_PATH=./data/app.db

# Sunucu portu ve dinleme adresi (0.0.0.0 = tüm ağ arayüzleri)
PORT=3000
HOST=0.0.0.0

# Oturum imzalama anahtarı (üretimde mutlaka uzun rastgele bir değerle değiştirin)
AUTH_SECRET=ornek-oturum-anahtari-6f3a9c1e8b2d4f70a5e9c3b1d8f2a6e4

# Platform sahibi (süper admin) girişi
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=Admin12345!
SUPER_ADMIN_EMAIL=owner@example.com

# Ana site marka bilgileri
BRAND_NAME=Nexora
BRAND_TAGLINE=Dijital hesap & kod teslimat altyapısı
BRAND_LOGO_URL=

# Bayilere gösterilen süre uzatma linki ve destek e-postası
RENEWAL_URL=https://t.me/ornek_destek
SUPPORT_EMAIL=destek@example.com

# Steam senkronizasyon cron uç noktası için gizli anahtar
CRON_SECRET=ornek-cron-anahtari-93kd82ls01

# Inventory credentials and 2FA secrets are encrypted at rest with this key
DATA_ENCRYPTION_KEY=
